# ── Supabase (Project Settings → API) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SECRET — serveur uniquement (dispatcher de notifications + suppression de compte)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Notifications push (génère-les avec : pnpm vapid) ───────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:ton-email@exemple.fr

# ── Cron : protège /api/cron/dispatch (pnpm vapid en génère un) ─────────────
CRON_SECRET=
